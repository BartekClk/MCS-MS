# ==============================================================================
# 1. Core & Logging
# ==============================================================================
BASE_DIR=./mcsms_data
LOGS_DIR=./mcsms_data/logs
CONSOLE_LOG_STATUSES=INIT,INFO,WARN,ERROR,FATAL,SUCCESS

# ==============================================================================
# 2. Server Instances (Main & Canary)
# ==============================================================================
SERVER_DIR=/path/to/main/server
WORLD_FOLDER_NAME=world
MAIN_SCREEN_SESSION=mc_main
MAIN_START_CMD=./run.sh nogui

CANARY_SERVER_DIR=/path/to/canary/server
CANARY_SCREEN_SESSION=mc_canary
CANARY_START_CMD=./run.sh nogui

# ==============================================================================
# 3. RCON Configuration & Scripts
# ==============================================================================
MAIN_RCON_HOST=127.0.0.1
MAIN_RCON_PORT=25575
MAIN_RCON_PASSWORD=change_me_main_rcon_password

CANARY_RCON_HOST=127.0.0.1
CANARY_RCON_PORT=25576
CANARY_RCON_PASSWORD=change_me_canary_rcon_password

RCON_SCRIPTS_DIR=./rcon
RCON_SHUTDOWN_SCRIPT=shutdown_countdown.txt

# ==============================================================================
# 4. Backup & Google Drive
# ==============================================================================
BACKUP_ARCHIVE_PREFIX=mcserver
BACKUP_EXCLUDE_DIRS=logs,crash-reports,cache
BACKUP_CHUNK_SIZE_MB=10
BACKUP_RETENTION_DAYS=14

GDRIVE_FOLDER_ID=your_google_drive_folder_id
GDRIVE_CREDENTIALS_PATH=./Google_OAuth_Files/credentials.json
GDRIVE_TOKEN_PATH=./Google_OAuth_Files/token.json

# ==============================================================================
# 5. Modpack Updater (Java, Packwiz & Timeouts)
# ==============================================================================
JAVA_BIN=/usr/bin/java
PACKWIZ_BOOTSTRAP_JAR=/path/to/packwiz-installer-bootstrap.jar
PACKWIZ_PACK_URL=https://raw.githubusercontent.com/owner/repo/main/pack.toml

SERVER_STOP_TIMEOUT=120
CANARY_BOOT_TIMEOUT=180
MAIN_BOOT_TIMEOUT=180
CANARY_STOP_AFTER_TEST=true

# ==============================================================================
# 6. GitHub Release Tracker & MOTD
# ==============================================================================
GITHUB_REPO=owner/repo
GITHUB_TOKEN=
RELEASE_STATE_FILE=./mcsms_data/installed_release.json
MOTD_TEMPLATE_PATH=./templates/motd_template.txt

# ==============================================================================
# 7. Discord Notifications (Players & Admin)
# ==============================================================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_TEMPLATE_PATH=./templates/discord_template.json

DISCORD_ADMIN_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ADMIN_ID/YOUR_ADMIN_TOKEN
DISCORD_ADMIN_TEMPLATE_PATH=./templates/discord_admin_template.json

# ==============================================================================
# 8. HTTP Daemon & Scheduler
# ==============================================================================
DAEMON_HOST=127.0.0.1
DAEMON_PORT=9000
DAEMON_WEBHOOK_SECRET=generate_a_long_random_hex_secret_here
DAILY_BACKUP_TIME=05:00